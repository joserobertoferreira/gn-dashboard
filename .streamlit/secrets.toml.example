# Copiar para .streamlit/secrets.toml e preencher.

[app]
# Ativa o modo debug (inclui o echo das queries SQL no log).
debug = false

[database]
server = "SERVIDOR\INSTANCIA"
database = "x3"
schema = "GN"
username = ""
password = ""
driver = "ODBC Driver 17 for SQL Server"
# "yes" para autenticação Windows (ignora username/password)
trusted_connection = "no"

# Chave antiga, ainda suportada se [app] debug não existir:
# debug = not production
# [debug]
# production = true
